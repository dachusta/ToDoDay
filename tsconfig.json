{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    // Скаффолд импортирует модули как 'src/...', а роуты — как 'pages/...' и
    // 'layouts/...' (runtime-алиасы Quasar/Vite; в docs/scaffold/vitest.config.ts объявлен
    // только 'src'). Сгенерированный .quasar/tsconfig.json знает лишь про '@',
    // поэтому typecheck не находил модули — дополняем карту алиасов.
    // '#q-app/wrappers' в app-vite 3 объявлен типами '@quasar/app-vite'
    // (exports-карта подпути не содержит) — отсюда явный маппинг.
    "baseUrl": ".",
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "src": ["./src"],
      "src/*": ["./src/*"],
      "pages/*": ["./src/pages/*"],
      "layouts/*": ["./src/layouts/*"],
      "components/*": ["./src/components/*"],
      "#q-app": ["./node_modules/@quasar/app-vite/types/index.d.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["src-pwa"],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "test/**/*.ts"]
}
