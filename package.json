{
  "name": "tododay",
  "version": "0.2.3",
  "description": "ToDoDay — микроменеджмент дел",
  "productName": "ToDoDay",
  "author": "you",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "predev": "node scripts/clean-qconf.mjs",
    "build": "quasar build",
    "prebuild": "node scripts/clean-qconf.mjs",
    "build:pwa": "quasar build -m pwa",
    "prebuild:pwa": "node scripts/clean-qconf.mjs",
    "clean:qconf": "node scripts/clean-qconf.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{scss,json}\"",
    "format:check": "prettier --check \"**/*.{scss,json}\"",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage",
    "typecheck": "vue-tsc --noEmit",
    "version:show": "node scripts/app-version.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "@vueuse/core": "^11.1.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.10",
    "pinia": "^3.0.4",
    "quasar": "^2.34.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@quasar/app-vite": "^3.10.1",
    "@types/node": "^22.7.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11"
  }
}
